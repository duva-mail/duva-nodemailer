{
  "name": "nodemailer-duva",
  "version": "0.1.0",
  "description": "Nodemailer transport for Duva, the transactional email API hosted in Canada.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://duva.ca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duva-mail/duva-nodemailer.git"
  },
  "bugs": {
    "url": "https://github.com/duva-mail/duva-nodemailer/issues"
  },
  "keywords": ["duva", "nodemailer", "email", "transport", "transactional-email"],
  "author": "9573-4562 Québec inc. <support@duva.ca>",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "duva-mail": "^0.2.0"
  },
  "peerDependencies": {
    "nodemailer": ">=6.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.15.0",
    "nodemailer": "^7.0.0",
    "tsup": "^8.3.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0"
  }
}
